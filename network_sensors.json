{
  "u01": {
    "kind": "treadmill",
    "endpoints": [
      {
        "host": "testingraspberryzero2.local",
        "port": 5000,
        "channels": {
          "incline": {
            "pattern": "^incline\\.grade: (-?\\d+(?:\\.\\d+)?)",
            "scale": 1.0,
            "unit": "%"
          },
          "belt_speed": {
            "pattern": "^tach\\.mph: (-?\\d+(?:\\.\\d+)?)",
            "scale": 1.0,
            "unit": "mph"
          }
        }
      }
    ]
  }
}
