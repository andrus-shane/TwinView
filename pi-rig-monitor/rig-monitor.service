[Unit]
Description=rig-monitor (WT901 + quadrature tach -> TCP for TwinView)
After=network-online.target pigpiod.service
Wants=network-online.target
Requires=pigpiod.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /opt/rig-monitor/rig_monitor.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
